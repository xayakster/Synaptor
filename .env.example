# ==============================================================================
# Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO GIT. Copy this file to .env for local development.
# ==============================================================================

# Context7 Live Documentation MCP
CONTEXT7_API_KEY=your_context7_api_key_here

# Tavily Web Search API
TAVILY_API_KEY=your_tavily_api_key_here

# Sentry Error Tracking
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your_sentry_org_slug_here

# Database Configuration
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/your_database_name

# EVM / Web3 RPC
RPC_URL=https://your-rpc-provider.com/v2/your_api_key
