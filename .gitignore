# ==============================================================================
# Synaptor .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
credentials.*
secrets.*

# Node.js & Dependencies
node_modules/
dist/
build/
.next/

# Python Ecosystem & Test Caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
venv/

# Databases & Runtime Logs
*.sqlite
*.sqlite3
*.db
*.log

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Ignored Directories & Scratch
archive/
docs/
scratch/
graphify-out/
brag-out/
.brag-cache/
task_plan.md
findings.md
progress.md